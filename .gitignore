# Node
node_modules/
npm-debug.log*

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Runtime SQLite database (generated locally; contains local/demo data, not source)
03 - ML/storage/*.db
03 - ML/storage/*.db-shm
03 - ML/storage/*.db-wal

# Large ML datasets / trained weights - raw data too large for git
03 - ML/data/deepbeat/*
!03 - ML/data/deepbeat/.gitkeep
!03 - ML/data/deepbeat/metadata.json
03 - ML/data/mimic_perform/*
!03 - ML/data/mimic_perform/.gitkeep
03 - ML/data/processed/*
!03 - ML/data/processed/.gitkeep
03 - ML/model/weights/*.npz
# ibi_af_v1 is the DEPLOYED classifier and only 1.3 KB. It must be tracked: the Pi is
# updated by `git pull`, so an ignored weights file cannot be deployed.
!03 - ML/model/weights/ibi_af_v1.npz
# cnn_af_v1 was never validly trained (see the 2026-10-01 audit). Kept tracked only until the
# adviser has seen the audit, then deleted per PLAN.md §9.5.
!03 - ML/model/weights/cnn_af_v1.npz
!03 - ML/model/weights/.gitkeep

# Training checkpoints (optimizer states & intermediate weights)
03 - ML/training/runs/**/*.pt

# Obsidian local workspace state & nested vault
.obsidian/workspace.json
.obsidian/workspace-mobile.json
Vault/

# Env / secrets
.env
.env.*
*.pem
*.key

# OS
Thumbs.db
.DS_Store

# Scratch working files
scratch/

# Credentials kept as a readable vault note rather than a dotenv, so it can be
# opened in Obsidian alongside the rest of the documentation. Never committed.
CREDENTIALS.md
